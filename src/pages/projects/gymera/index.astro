  @keyframes sliderReveal {
    0% { opacity: 0; clip-path: inset(0 100% 0 0); }
    7% { opacity: 1; clip-path: inset(0 0 0 0); }
    24% { opacity: 1; clip-path: inset(0 0 0 0); }
    31% { opacity: 0; clip-path: inset(0 0 0 100%); }
    100% { opacity: 0; clip-path: inset(0 100% 0 0); }
  }
  @keyframes instantThree {
    0%, 32.99% { opacity: 1; clip-path: none; }
    33%, 100% { opacity: 0; clip-path: none; }
  }
  @keyframes instantFive {
    0%, 19.99% { opacity: 1; clip-path: none; }
    20%, 100% { opacity: 0; clip-path: none; }
  }
  @keyframes instantSix {
    0%, 16.65% { opacity: 1; clip-path: none; }
    16.66%, 100% { opacity: 0; clip-path: none; }
  }
  @keyframes motorSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  @keyframes motorPulse {
    0% { opacity: 0; transform: translateX(-34%); }
    12%, 72% { opacity: 1; }
    100% { opacity: 0; transform: translateX(300%); }
  }
  @keyframes motorBars {
    0%, 100% { height: 34%; opacity: .62; }
    50% { height: 92%; opacity: 1; }
  }
  @keyframes homepageScroll {
    0%, 8% { transform: translateY(0); }
    88%, 96% { transform: translateY(-88%); }
    100% { transform: translateY(0); }
  }
  @keyframes stillFade {
    0%, 100% { opacity: 0; }
    8%, 24% { opacity: 1; }
    32% { opacity: 0; }
  }
  @keyframes mapPan {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(var(--map-slide-width) * -1)); }
  }
  @keyframes usageDarkWipe {
    0%, 48% { clip-path: inset(0 100% 0 0); }
    58%, 88% { clip-path: inset(0 0 0 0); }
    96%, 100% { clip-path: inset(0 100% 0 0); }
  }
  @keyframes usageLine {
    0%, 47%, 96%, 100% { left: 0; opacity: 0; }
    50% { left: 0; opacity: 1; }
    58%, 88% { left: 100%; opacity: 1; }
    92% { left: 100%; opacity: 0; }
  }
  @keyframes usageCopySwap {
    0%, 52%, 94%, 100% { opacity: 0; }
    58%, 88% { opacity: 1; }
