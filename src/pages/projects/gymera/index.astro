<script>
  const params = new URLSearchParams(location.search);
  const ownerParam = params.get("owner");
  const editParam = params.get("edit");
  if (ownerParam === "1") localStorage.setItem("prokha-owner-mode", "1");
  if (ownerParam === "0") localStorage.removeItem("prokha-owner-mode");
  localStorage.removeItem("prokha-edit-links");

  let editLinksVisible = editParam === "1";
  const revealOwnerControls = () => {
    const isOwner = localStorage.getItem("prokha-owner-mode") === "1";
    const showEditLinks = isOwner && editLinksVisible;
    document.querySelectorAll("[data-owner-only]").forEach((element) => {
      element.hidden = !isOwner;
    });
    document.querySelectorAll("[data-edit-only]").forEach((element) => {
      element.hidden = !showEditLinks;
    });
  };

  revealOwnerControls();

  let editCommand = "";
  document.addEventListener("keydown", (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey || event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
    editCommand = (editCommand + event.key.toLowerCase()).slice(-4);
    if (editCommand === "edit") {
      editLinksVisible = true;
      revealOwnerControls();
    }
  });

  const initGymeraSequence = () => {
    const stage = document.querySelector("[data-gymera-sequence]");
    const frame = stage?.querySelector(".hero-sequence-frame");
    const video = stage?.querySelector(".hero-sequence-video");
    if (!stage || !(frame instanceof HTMLImageElement)) return;

    if (video instanceof HTMLVideoElement) {
      const markReady = () => stage.classList.add("is-video-ready");
      video.addEventListener("loadeddata", markReady, { once: true });
      video.addEventListener("canplay", markReady, { once: true });
      video.play?.().catch(() => {});
      return;
    }

    const frameBase = stage.getAttribute("data-frame-base") || "";
    const frameCount = Number(stage.getAttribute("data-frame-count") || "0");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const formatFrame = (index) => `${frameBase}${String(index).padStart(4, "0")}.png`;
    const cache = new Map();
    let current = 1;
    let lastTick = 0;
    let isVisible = true;

    const preload = (index) => {
      if (!frameBase || index < 1 || index > frameCount || cache.has(index)) return;
      const image = new Image();
      image.decoding = "async";
      image.src = formatFrame(index);
      cache.set(index, image);
    };

    const warmup = (from) => {
      for (let offset = 1; offset <= 18; offset += 1) {
        preload(((from + offset - 1) % frameCount) + 1);
      }
    };

    const step = (time) => {
      if (!reduceMotion && isVisible && frameCount > 1 && time - lastTick > 1000 / 24) {
        current = (current % frameCount) + 1;
        frame.src = formatFrame(current);
        warmup(current);
        lastTick = time;
      }
      requestAnimationFrame(step);
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
        });
      }, { threshold: 0.05 });
      observer.observe(stage);
    }

    preload(1);
    warmup(1);
    requestAnimationFrame(step);
  };

  const initCaseNavigation = () => {
    const trigger = document.querySelector("[data-case-nav-trigger]");
    const sidebar = document.querySelector("[data-case-sidebar]");
    if (!(trigger instanceof HTMLElement) || !(sidebar instanceof HTMLElement)) return;

    let collapseTimer = 0;

    const setCollapsed = (collapsed) => {
      document.body.classList.toggle("case-nav-collapsed", collapsed);
      trigger.setAttribute("aria-expanded", String(!collapsed));
    };

    const scheduleCollapse = (delay = 450) => {
      window.clearTimeout(collapseTimer);
      collapseTimer = window.setTimeout(() => setCollapsed(true), delay);
    };

    const keepOpen = () => {
      window.clearTimeout(collapseTimer);
      setCollapsed(false);
    };

    trigger.addEventListener("mouseenter", keepOpen);
    sidebar.addEventListener("mouseenter", keepOpen);
    trigger.addEventListener("focus", keepOpen);
    trigger.addEventListener("mouseleave", () => scheduleCollapse());
    trigger.addEventListener("blur", () => scheduleCollapse());
    sidebar.addEventListener("mouseleave", () => scheduleCollapse());
    scheduleCollapse(1800);
  };

  const initGymeraHero = () => {
    const stage = document.querySelector("[data-gymera-hero]");
    const canvas = document.getElementById("gymera-hero-canvas");
    const mesh = window.GYMERA_HERO_MESH;
    document.documentElement.dataset.gymeraHeroMesh = String(mesh?.points?.length || 0);
    if (!stage || !(canvas instanceof HTMLCanvasElement) || !mesh?.points?.length) {
      stage?.classList.add("is-fallback");
      document.documentElement.dataset.gymeraHeroMode = "fallback";
      return;
    }

    const context = canvas.getContext("2d", { alpha: true });
    if (!context) {
      stage.classList.add("is-fallback");
      document.documentElement.dataset.gymeraHeroMode = "fallback";
      return;
    }
    document.documentElement.dataset.gymeraHeroMode = "canvas";

    const fills = [[34, 39, 46], [116, 214, 205], [15, 17, 21], [24, 27, 32], [92, 101, 112], [38, 43, 51]];
    const strokes = [[142, 156, 169], [190, 255, 248], [82, 86, 94], [82, 90, 99], [214, 220, 222], [154, 166, 178]];
    let camera = { p: [-0.08, -0.03, 0.04], d: 1.78, yaw: -0.72, pitch: 0.12 };
    let points2d = [];

    const lerp = (a, b, t) => a + (b - a) * t;
    const mix3 = (a, b, t) => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
    const rgba = (rgb, alpha) => `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${alpha})`;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const project = (point, time) => {
      const target = { p: [-0.08, -0.03, 0.04], d: 1.78, yaw: -0.72 + Math.sin(time * .0002) * .05, pitch: .12 + Math.cos(time * .00016) * .035 };
      camera.p = mix3(camera.p, target.p, .035);
      camera.d = lerp(camera.d, target.d, .035);
      camera.yaw = lerp(camera.yaw, target.yaw, .035);
      camera.pitch = lerp(camera.pitch, target.pitch, .035);

      const cy = Math.cos(camera.yaw);
      const sy = Math.sin(camera.yaw);
      const cp = Math.cos(camera.pitch);
      const sp = Math.sin(camera.pitch);
      const x = point[0] - camera.p[0];
      const y = point[1] - camera.p[1];
      const z = point[2] - camera.p[2];
      const x1 = x * cy - z * sy;
      const z1 = x * sy + z * cy;
      const y1 = y * cp - z1 * sp;
      const z2 = y * sp + z1 * cp;
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const scale = Math.min(width, height) * camera.d;
      const depth = 2.66 + z2;

      return {
        x: width * .66 + (x1 / depth) * scale,
        y: height * .59 - (y1 / depth) * scale,
        z: z2,
        depth,
      };
    };

    const normal = (a, b, c) => {
      const ux = b[0] - a[0];
      const uy = b[1] - a[1];
      const uz = b[2] - a[2];
      const vx = c[0] - a[0];
      const vy = c[1] - a[1];
      const vz = c[2] - a[2];
      const nx = uy * vz - uz * vy;
      const ny = uz * vx - ux * vz;
      const nz = ux * vy - uy * vx;
      const length = Math.hypot(nx, ny, nz) || 1;
      return [nx / length, ny / length, nz / length];
    };

    const drawPath = (poly) => {
      context.beginPath();
      context.moveTo(points2d[poly[0]].x, points2d[poly[0]].y);
      for (let index = 1; index < poly.length; index += 1) {
        context.lineTo(points2d[poly[index]].x, points2d[poly[index]].y);
      }
      context.closePath();
    };

    const draw = (time) => {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      context.clearRect(0, 0, width, height);

      const glow = context.createRadialGradient(width * .62, height * .34, 0, width * .62, height * .34, Math.max(width, height) * .65);
      glow.addColorStop(0, "rgba(218,238,242,.16)");
      glow.addColorStop(.34, "rgba(70,91,98,.07)");
      glow.addColorStop(1, "rgba(0,0,0,0)");
      context.fillStyle = glow;
      context.fillRect(0, 0, width, height);

      points2d = mesh.points.map((point) => project(point, time));
      const polys = mesh.polys
        .map((entry) => [entry, entry[0].reduce((sum, index) => sum + points2d[index].z, 0) / entry[0].length])
        .sort((a, b) => a[1] - b[1]);

      for (const [entry] of polys) {
        const poly = entry[0];
        const tag = entry[1];
        if (poly.some((index) => points2d[index].depth <= .2 || !Number.isFinite(points2d[index].x + points2d[index].y))) continue;
        const n = normal(mesh.points[poly[0]], mesh.points[poly[1]], mesh.points[poly[2]]);
        const key = Math.max(0, n[0] * -.34 + n[1] * .5 + n[2] * .76);
        const rim = Math.pow(Math.max(0, 1 - Math.abs(n[2])), 2.4);
        const base = fills[tag] || fills[0];
        const red = Math.min(255, base[0] + key * 64 + rim * 44);
        const green = Math.min(255, base[1] + key * 64 + rim * 44);
        const blue = Math.min(255, base[2] + key * 68 + rim * 50);
        drawPath(poly);
        context.fillStyle = `rgba(${red | 0},${green | 0},${blue | 0},${tag === 1 ? .7 : .84})`;
        context.fill();
      }

      context.save();
      context.globalCompositeOperation = "lighter";
      context.lineCap = "round";
      for (const edge of mesh.edges) {
        const a = points2d[edge[0]];
        const b = points2d[edge[1]];
        if (a.depth <= .2 || b.depth <= .2) continue;
        const tag = edge[2];
        const depth = Math.max(0, Math.min(1, (a.z + b.z) * .18 + .5));
        context.strokeStyle = rgba(strokes[tag] || strokes[0], tag === 1 ? .34 : .13 + depth * .18);
        context.lineWidth = tag === 1 ? 1.05 : .45;
        context.beginPath();
        context.moveTo(a.x, a.y);
        context.lineTo(b.x, b.y);
        context.stroke();
      }
      context.restore();

      const floor = context.createLinearGradient(0, height * .62, 0, height);
      floor.addColorStop(0, "rgba(122,222,214,0)");
      floor.addColorStop(.72, "rgba(122,222,214,.1)");
      floor.addColorStop(1, "rgba(122,222,214,.18)");
      context.fillStyle = floor;
      context.fillRect(0, height * .62, width, height * .38);

      requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener("resize", resize);
    requestAnimationFrame(draw);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGymeraSequence, { once: true });
    document.addEventListener("DOMContentLoaded", initCaseNavigation, { once: true });
  } else {
    initGymeraSequence();
    initCaseNavigation();
  }
</script>

<style>
  :root {
    color-scheme: light;
    --bg: #eef4fb;
    --paper: #fff;
    --ink: #05070a;
    --muted: #607080;
    --line: rgba(5, 7, 10, .12);
    --accent: #9f5cff;
    --blue: #3189ff;
    --signal: #98ff44;
    --cloud: #edf5ff;
    --radius: 8px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); overflow-x: hidden; }
  a { color: inherit; text-decoration: none; }
  p, h1, h2, h3, h4, dl, dd, figure, ul { margin: 0; }
  ul { list-style: none; padding: 0; }
  img, video { display: block; max-width: 100%; }
  button { font: inherit; }
  [hidden] { display: none !important; }

  .site-header {
    align-items: center;
    background: rgba(238, 244, 251, .92);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr auto 1fr;
    left: 0;
    padding: 20px clamp(20px, 4vw, 72px);
    position: sticky;
    right: 0;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(18px);
  }

  .brand {
    align-items: center;
    display: inline-flex;
    font-size: 28px;
    font-weight: 900;
    gap: 10px;
    justify-self: start;
  }
  .back-link { font-size: 14px; font-weight: 800; }
  .back-link span { margin-right: 8px; }
  .button {
    align-items: center;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    display: inline-flex;
    font-size: 14px;
    font-weight: 800;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
  }
  .button.light { background: transparent; }
  .button.small { justify-self: end; min-height: 42px; }
  .header-actions { display: flex; gap: 8px; justify-self: end; }
  .edit-page {
    background: transparent !important;
    border-color: rgba(5, 7, 10, .18) !important;
    color: rgba(5, 7, 10, .46) !important;
  }

  main {
    display: grid;
    grid-template-columns: minmax(280px, 25vw) minmax(0, 1fr);
    min-width: 0;
    transition: grid-template-columns .42s cubic-bezier(.16, 1, .3, 1);
  }
  body.case-nav-collapsed main {
    grid-template-columns: 0 minmax(0, 1fr);
  }
  .case-sidebar {
    align-content: space-between;
    background: var(--paper);
    border-right: 1px solid var(--line);
    display: grid;
    gap: 44px;
    height: calc(100vh - 83px);
    padding: clamp(36px, 4vw, 64px) clamp(24px, 3vw, 48px);
    position: sticky;
    top: 83px;
    overflow: hidden;
    transition: opacity .28s ease, transform .42s cubic-bezier(.16, 1, .3, 1), visibility .28s ease;
  }
  body.case-nav-collapsed .case-sidebar {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-20px);
    visibility: hidden;
  }
  .case-content {
    min-width: 0;
    overflow: hidden;
  }
  .eyebrow {
    color: var(--accent);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
    margin-bottom: 16px;
    text-transform: uppercase;
  }
  .gymera-mark {
    align-items: center;
    background: #fff;
    display: inline-flex;
    margin-bottom: 32px;
    min-height: 46px;
    padding: 0;
    width: min(100%, 230px);
  }
  .gymera-mark img {
    height: auto;
    width: 100%;
  }
  h1 { font-size: clamp(25px, 2.25vw, 38px); hyphens: auto; line-height: 1.08; overflow-wrap: anywhere; }
  h2 { font-size: clamp(32px, 4.5vw, 68px); line-height: 1.02; max-width: 940px; }
  .intro, .section-copy > p:last-child, .result-copy > p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
    margin-top: 22px;
  }
  dl { border-top: 1px solid var(--line); }
  dl div { border-bottom: 1px solid var(--line); display: flex; gap: 18px; justify-content: space-between; padding: 11px 0; }
  dt { color: var(--muted); font-size: 12px; font-weight: 800; text-transform: uppercase; }
  dd { font-size: 13px; font-weight: 800; text-align: right; }
  nav { display: grid; gap: 10px; }
  nav a { color: var(--muted); font-size: 12px; font-weight: 800; text-transform: uppercase; }
  nav a:hover { color: var(--ink); }

  .case-content > section { border-bottom: 1px solid var(--line); padding: clamp(56px, 7vw, 110px) clamp(24px, 6vw, 100px); }
  .hero {
    background: #05070a;
    min-height: calc(100vh - 83px);
    padding: 0 !important;
  }
  .hero-copy { display: grid; gap: 28px; grid-template-columns: 1fr minmax(260px, 420px); margin-bottom: 58px; }
  .hero-copy .eyebrow { grid-column: 1 / -1; }
  .hero-copy p:last-child { align-self: end; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .hero-media, .wide-frame {
    background: var(--ink);
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: var(--radius);
    box-shadow: 0 26px 80px rgba(42, 59, 88, .18);
    overflow: hidden;
  }
  .hero-media img { aspect-ratio: 21 / 9; object-fit: cover; object-position: center; width: 100%; }
  .hero-3d {
    position: relative;
    min-height: min(68vh, 720px);
    background:
      radial-gradient(circle at 72% 24%, rgba(210, 236, 241, .16), transparent 22%),
      radial-gradient(circle at 48% 84%, rgba(142, 232, 222, .14), transparent 28%),
      linear-gradient(180deg, #060909, #010202);
    isolation: isolate;
  }
  .hero-3d::after {
    background: linear-gradient(180deg, transparent, rgba(1, 2, 2, .68));
    bottom: 0;
    content: "";
    height: 32%;
    left: 0;
    pointer-events: none;
    position: absolute;
    right: 0;
    z-index: 2;
  }
  #gymera-hero-canvas {
    display: block;
    height: min(68vh, 720px);
    min-height: 520px;
    position: relative;
    width: 100%;
    z-index: 1;
  }
  .hero-3d-fallback {
    display: none;
    inset: 0;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    opacity: .86;
    position: absolute;
    width: 100%;
    z-index: 0;
  }
  .hero-3d-copy {
    bottom: 56px;
    color: #fff;
    left: clamp(22px, 4vw, 48px);
    max-width: 420px;
    position: absolute;
    text-shadow: 0 20px 54px rgba(0, 0, 0, .95);
    z-index: 3;
  }
  .hero-3d-copy strong {
    display: block;
    font-size: clamp(28px, 4vw, 56px);
    font-weight: 950;
    letter-spacing: -.03em;
    line-height: .96;
    margin-top: 10px;
  }
  .hero-3d-kicker {
    color: rgba(190, 255, 248, .78);
    display: block;
    font-size: 11px;
    font-weight: 950;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .hero-3d.is-fallback #gymera-hero-canvas {
    display: none;
  }
  .hero-3d.is-fallback .hero-3d-fallback {
    display: block;
  }
  .hero-sequence {
    aspect-ratio: auto;
    background: #010202;
    contain: layout paint;
    min-height: calc(100vh - 83px);
    position: relative;
    isolation: isolate;
    width: 100%;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .hero-sequence::before {
    background:
      linear-gradient(90deg, #000 0%, rgba(0, 0, 0, .86) 4%, transparent 15%, transparent 85%, rgba(0, 0, 0, .86) 96%, #000 100%),
      linear-gradient(180deg, #000 0%, rgba(0, 0, 0, .78) 14%, transparent 42%, rgba(0, 0, 0, .42) 100%);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 4;
  }
  .hero-sequence-bg {
    background:
      radial-gradient(ellipse at 24% 76%, rgba(159, 92, 255, .22), transparent 26%),
      radial-gradient(ellipse at 72% 76%, rgba(26, 210, 214, .2), transparent 27%),
      radial-gradient(circle at 50% 24%, rgba(49, 137, 255, .1), transparent 31%),
      linear-gradient(180deg, #000 0%, #030506 52%, #000 100%);
    inset: 0;
    position: absolute;
    z-index: 0;
  }
  .hero-sequence-bg::before {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .02), transparent 34%),
      radial-gradient(ellipse at 50% 88%, rgba(255, 255, 255, .07), transparent 36%);
    content: "";
    inset: 0;
    opacity: .86;
    position: absolute;
  }
  .hero-sequence-bg::after {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, .92), rgba(0, 0, 0, .68) 30%, transparent 54%, rgba(0, 0, 0, .82)),
      linear-gradient(180deg, #000 0%, rgba(0, 0, 0, .92) 18%, transparent 46%, rgba(0, 0, 0, .84));
    content: "";
    inset: 0;
    position: absolute;
  }
  .hero-media .hero-sequence-logo,
  .hero-media .hero-sequence-video,
  .hero-media .hero-sequence-frame {
    aspect-ratio: auto;
    max-width: none;
    position: absolute;
  }
  .hero-media .hero-sequence-logo {
    filter: brightness(0) invert(1);
    height: auto;
    left: 50%;
    opacity: .06;
    top: 34%;
    transform: translate(-50%, -50%);
    width: min(78%, 900px);
    z-index: 1;
  }
  .hero-media .hero-sequence-video {
    bottom: 0;
    display: block;
    height: 100%;
    left: 0;
    object-fit: cover;
    object-position: center bottom;
    width: 100%;
    z-index: 3;
  }
  .hero-media .hero-sequence-frame {
    bottom: 0;
    height: 100%;
    left: 0;
    object-fit: cover;
    object-position: center bottom;
    width: 100%;
    z-index: 2;
  }
  .hero-sequence.is-video-ready .hero-sequence-frame {
    display: none;
  }
  .hero-sequence-copy {
    color: #fff;
    left: clamp(20px, 4vw, 48px);
    max-width: min(48vw, 760px);
    position: absolute;
    text-shadow: 0 18px 50px rgba(0, 0, 0, .92);
    top: clamp(26px, 5vw, 68px);
    z-index: 5;
  }
  .hero-sequence-copy h2 {
    color: #fff;
    display: block;
    font-size: clamp(38px, 5.3vw, 82px);
    font-weight: 950;
    letter-spacing: 0;
    line-height: .92;
    margin-top: 16px;
    max-width: 820px;
  }
  .hero-sequence-copy p {
    color: rgba(255, 255, 255, .58);
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.6;
    margin-top: 22px;
    max-width: min(34vw, 560px);
  }
  .hero-sequence-kicker {
    color: rgba(190, 255, 248, .78);
    display: block;
    font-size: 11px;
    font-weight: 950;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .hero-sequence-caption,
  .hero-media > span:not(.hero-sequence-kicker),
  figcaption {
    color: rgba(255, 255, 255, .82);
    display: block;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
    padding: 16px 18px;
    text-transform: uppercase;
  }
  .hero-sequence-caption {
    background: linear-gradient(90deg, rgba(0, 0, 0, .72), rgba(0, 0, 0, .08));
    bottom: 0;
    left: 0;
    position: absolute;
    right: 0;
    z-index: 4;
  }

  .reel-section {
    background:
      radial-gradient(circle at 82% 10%, rgba(152, 255, 68, .16), transparent 28%),
      linear-gradient(135deg, #05070a, #121b2b);
    color: #fff;
  }
  .brief-section {
    background: #fff;
    align-items: start;
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, .92fr) minmax(360px, .8fr);
  }
  .brief-constraints-section {
    background: #f7faff;
  }
  .brief-source-video {
    background:
      linear-gradient(#f7faff, #edf3fb) padding-box,
      linear-gradient(135deg, rgba(5, 7, 10, .16), rgba(49, 137, 255, .18)) border-box;
    border: 1px solid transparent;
    border-radius: var(--radius);
    box-shadow: 0 24px 70px rgba(42, 59, 88, .1);
    margin-top: 0;
    max-width: none;
    overflow: hidden;
    padding: 10px;
  }
  .brief-source-video video {
    aspect-ratio: 680 / 382;
    background: #05070a;
    border-radius: 5px;
    display: block;
    filter: grayscale(1) contrast(.92) brightness(.86);
    object-fit: cover;
    width: 100%;
  }
  .brief-source-video figcaption {
    background: transparent;
    color: rgba(5, 7, 10, .56);
    padding: 14px 8px 4px;
  }
  .brief-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 44px;
  }
  .brief-grid article,
  .source-grid article,
  .immersion-grid article {
    border-radius: var(--radius);
    min-width: 0;
  }
  .brief-grid article {
    background: var(--cloud);
    border: 1px solid rgba(49, 137, 255, .16);
    min-height: 250px;
    padding: 24px;
  }
  .brief-grid h3,
  .source-grid h3,
  .immersion-grid h3 {
    font-size: 21px;
    line-height: 1.12;
  }
  .brief-grid p,
  .source-grid p,
  .immersion-grid p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.58;
    margin-top: 18px;
  }
  .product-render-section {
    background:
      radial-gradient(circle at 82% 12%, rgba(49, 137, 255, .12), transparent 28%),
      linear-gradient(180deg, #fff 0%, #eef4fb 100%);
  }
  .asset-method-section {
    background: #fff;
  }
  .rescue-showcase {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 26px 80px rgba(42, 59, 88, .12);
    margin-top: 48px;
    overflow: hidden;
    padding: clamp(14px, 2vw, 24px);
  }
  .rescue-artifact-grid {
    background: #fff;
    display: grid;
    gap: clamp(10px, 1.5vw, 18px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .rescue-artifact-grid img {
    aspect-ratio: 4 / 3;
    background: #f5f7fb;
    border: 1px solid rgba(42, 59, 88, .12);
    border-radius: 6px;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    object-position: center;
    padding: clamp(10px, 1.6vw, 22px);
    width: 100%;
  }
  .rescue-showcase figcaption {
    background: #fff;
    color: rgba(5, 7, 10, .68);
    padding: 18px 4px 0;
  }
  .render-gallery {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
    margin-top: 48px;
  }
  .render-gallery figure {
    background: #05070a;
    border: 1px solid rgba(5, 7, 10, .12);
    border-radius: var(--radius);
    box-shadow: 0 26px 80px rgba(42, 59, 88, .16);
    overflow: hidden;
  }
  .render-gallery figure:not(.render-main) img {
    aspect-ratio: 4 / 3;
  }
  .render-main {
    grid-row: span 2;
  }
  .render-main img {
    aspect-ratio: 4 / 3;
  }
  .render-gallery img {
    height: 100%;
    object-fit: cover;
    object-position: center;
    width: 100%;
  }
  .render-main img {
    object-position: 72% center;
  }
  .product-proof {
    margin-top: 18px;
  }
  .motor-system-section {
    background:
      radial-gradient(circle at 18% 18%, rgba(159, 92, 255, .18), transparent 28%),
      radial-gradient(circle at 82% 22%, rgba(80, 237, 220, .18), transparent 30%),
      linear-gradient(145deg, #05070a 0%, #0b111b 52%, #05070a 100%);
    color: #fff;
  }
  .motor-system-section .section-copy > p:last-child {
    color: rgba(255, 255, 255, .68);
  }
  .motor-system-stage {
    align-items: stretch;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1.28fr) minmax(260px, .72fr);
    margin-top: 48px;
  }
  .motor-video-frame {
    background:
      linear-gradient(#071018, #05070a) padding-box,
      linear-gradient(135deg, rgba(80, 237, 220, .6), rgba(159, 92, 255, .42), rgba(49, 137, 255, .5)) border-box;
    border: 1px solid transparent;
    border-radius: var(--radius);
    box-shadow: 0 34px 120px rgba(0, 0, 0, .34);
    margin: 0;
    overflow: hidden;
    padding: 10px;
  }
  .motor-video-frame video {
    aspect-ratio: 680 / 382;
    background: #05070a;
    border-radius: 5px;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .motor-video-frame figcaption {
    background:
      linear-gradient(90deg, rgba(5, 7, 10, .96), rgba(5, 7, 10, .68)),
      radial-gradient(circle at 12% 50%, rgba(80, 237, 220, .18), transparent 28%);
    border-radius: 0 0 5px 5px;
    margin-top: 10px;
  }
  .motor-product-shell {
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(ellipse at 30% 82%, rgba(159, 92, 255, .24), transparent 32%),
      radial-gradient(ellipse at 72% 82%, rgba(80, 237, 220, .28), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, .05), rgba(255, 255, 255, .015));
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: var(--radius);
    box-shadow: 0 34px 120px rgba(0, 0, 0, .34);
    min-height: 420px;
    overflow: hidden;
    position: relative;
  }
  .motor-product-shell::before {
    background:
      linear-gradient(90deg, transparent, rgba(255, 255, 255, .16), transparent),
      linear-gradient(180deg, rgba(255, 255, 255, .06), transparent 42%);
    content: "";
    inset: 0;
    opacity: .62;
    pointer-events: none;
    position: absolute;
  }
  .motor-product-shell::after {
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, .72));
    bottom: 0;
    content: "";
    height: 34%;
    left: 0;
    position: absolute;
    right: 0;
  }
  .motor-frame-upright,
  .motor-console,
  .motor-tower,
  .motor-base,
  .motor-bench {
    position: absolute;
    z-index: 2;
  }
  .motor-frame-upright {
    border: 10px solid rgba(200, 236, 236, .28);
    border-bottom: 0;
    border-radius: 38px 38px 0 0;
    height: 49%;
    left: 27%;
    top: 14%;
    width: 30%;
  }
  .motor-console {
    background:
      linear-gradient(145deg, rgba(178, 255, 248, .22), rgba(5, 7, 10, .92)),
      radial-gradient(circle at 24% 20%, rgba(255, 255, 255, .58), transparent 20%);
    border: 1px solid rgba(190, 255, 248, .24);
    border-radius: 8px;
    box-shadow: 0 0 36px rgba(80, 237, 220, .18);
    height: 21%;
    left: 36%;
    top: 18%;
    transform: skewY(-2deg);
    width: 15%;
  }
  .motor-tower {
    background: linear-gradient(90deg, rgba(236, 248, 252, .16), rgba(236, 248, 252, .34), rgba(5, 7, 10, .08));
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 8px 8px 18px 18px;
    bottom: 25%;
    height: 43%;
    left: 31%;
    width: 21%;
  }
  .motor-base {
    background:
      linear-gradient(100deg, rgba(198, 233, 240, .18), rgba(198, 233, 240, .05)),
      linear-gradient(180deg, rgba(8, 16, 22, .16), rgba(8, 16, 22, .56));
    border: 1px solid rgba(190, 255, 248, .28);
    border-radius: 18px;
    bottom: 19%;
    box-shadow:
      inset 0 0 42px rgba(190, 255, 248, .09),
      0 0 70px rgba(49, 137, 255, .16);
    height: 25%;
    left: 22%;
    overflow: hidden;
    width: 53%;
  }
  .motor-glass-panel {
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 14px;
    inset: 10px;
    position: absolute;
  }
  .motor-rail {
    background: rgba(180, 225, 255, .3);
    border-radius: 999px;
    height: 2px;
    left: 8%;
    position: absolute;
    right: 8%;
  }
  .motor-rail-top { top: 27%; }
  .motor-rail-bottom { bottom: 23%; }
  .motor-pulse {
    animation: motorPulse 2.8s linear infinite;
    background: linear-gradient(90deg, transparent, rgba(163, 244, 255, .98), transparent);
    border-radius: 999px;
    height: 3px;
    left: 8%;
    position: absolute;
    width: 24%;
  }
  .motor-pulse-top { top: 26%; }
  .motor-pulse-bottom {
    animation-delay: -1.4s;
    bottom: 22%;
  }
  .motor-wheel {
    animation: motorSpin 1.8s linear infinite;
    background:
      radial-gradient(circle, rgba(5, 7, 10, .92) 0 16%, transparent 17%),
      repeating-conic-gradient(from 0deg, rgba(255, 255, 255, .84) 0 12deg, rgba(86, 118, 132, .58) 12deg 26deg),
      radial-gradient(circle at 35% 30%, #ffffff, #6f7c82 46%, #161d22 72%);
    border: 1px solid rgba(255, 255, 255, .34);
    border-radius: 50%;
    bottom: 23%;
    box-shadow: 0 0 28px rgba(190, 255, 248, .34);
    height: 40%;
    position: absolute;
    width: 17%;
  }
  .motor-wheel span {
    border: 2px solid rgba(5, 7, 10, .35);
    border-radius: 50%;
    inset: 20%;
    position: absolute;
  }
  .motor-wheel-left { left: 29%; }
  .motor-wheel-right { right: 30%; }
  .motor-belt {
    border: 4px solid rgba(190, 255, 248, .7);
    border-bottom-color: rgba(190, 255, 248, .18);
    border-radius: 999px;
    bottom: 30%;
    height: 34%;
    left: 23%;
    position: absolute;
    width: 55%;
  }
  .motor-control-unit {
    background: rgba(5, 7, 10, .74);
    border: 1px solid rgba(190, 255, 248, .2);
    border-radius: 10px;
    display: flex;
    gap: 5px;
    height: 28%;
    padding: 9px;
    position: absolute;
    right: 9%;
    top: 18%;
